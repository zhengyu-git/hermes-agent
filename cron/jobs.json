64) AppleWebKit/537.36'}\ndef fetch_titles(url):\n    try:\n        r = requests.get(url, headers=headers, timeout=15)\n        r.encoding = 'utf-8'\n        text = re.sub(r'<script[^>]*>.*?</script>', '', r.text, flags=re.DOTALL)\n        text = re.sub(r'<style[^>]*>.*?</style>', '', text, flags=re.DOTALL)\n        titles = re.findall(r'<a[^>]+href=[^>]+>([^<]{10,80})</a>', text)\n        nav = {'\u9996\u9875','\u65b0\u95fb','\u8d22\u7ecf','\u4f53\u80b2','\u5a31\u4e50','\u519b\u4e8b','\u79d1\u6280','\u793e\u4f1a','\u89c6\u9891','\u56fe\u7247','\u66f4\u591a','\u76f8\u5173','\u63a8\u8350'}\n        titles = [t.strip() for t in titles if t.strip() not in nav and 10 < len(t.strip()) < 80]\n        return titles[:30]\n    except:\n        return []\n\nfor name, url in [('\u4eba\u6c11\u7f51','http://www.people.com.cn/'),('\u65b0\u534e\u7f51','http://www.news.cn/'),('\u4e2d\u65b0\u793e','https://www.chinanews.com/'),('\u6f8e\u6e43','https://www.thepaper.cn/'),('\u592e\u89c6','https://news.cctv.com/'),('\u65b0\u6d6a\u56fd\u9645','https://news.sina.com.cn/world/')]:\n    titles = fetch_titles(url)\n    print(f\"=== {name} ===\", titles[:10])\n```\n\n**\u3010\u8f93\u51fa\u683c\u5f0f - \u91cd\u8981\uff1a\u5355\u6761\u6d88\u606f\u5305\u542b\u56fd\u5185\u548c\u56fd\u9645\u4e24\u90e8\u5206\uff0c\u7981\u6b62\u7528 --- \u5206\u9694\u3011**\n\n**\u683c\u5f0f\uff1a**\n\ud83d\udcf0 X\u6708X\u65e5\uff08\u5468X\uff09[\u5348\u95f4/\u665a\u95f4/\u591c\u95f4]\u901f\u62a5\n\n\ud83c\udde8\ud83c\uddf3 \u4e2d\u56fd\u56fd\u5185\n- [\u56fd\u5185\u65b0\u95fb1]\n- [\u56fd\u5185\u65b0\u95fb2]\n...\n\n\ud83c\udf0d \u56fd\u9645\n- [\u56fd\u9645\u65b0\u95fb1]\n- [\u56fd\u9645\u65b0\u95fb2]\n...\n\n**\u89c4\u5219\uff1a**\n- **\u56fd\u518512-15\u6761\uff0c\u56fd\u964512-15\u6761**\uff0c\u6bcf\u676120\u5b57\u4ee5\u4e0a\n- \u7eaf\u4e2d\u6587\n- **\u5168\u90e8\u5185\u5bb9\u653e\u5728\u4e00\u6761\u6d88\u606f\u91cc\u8f93\u51fa\uff0c\u4e0d\u8981\u7528 --- \u6216\u4efb\u4f55\u5206\u9694\u7ebf\u62c6\u5206\u6210\u591a\u6761**\n- \u5982\u679c\u9a8c\u8bc1\u672a\u901a\u8fc7\uff08\u56fd\u5185\u6216\u56fd\u9645\u4e0d\u8db310\u6761\uff09\uff0c\u8f93\u51fa `[SILENT]`\n\n**\u3010\u8f93\u51fa\u524d\u9a8c\u8bc1\u3011**\n1. \u662f\u5426\u6709\u81f3\u5c1110\u6761\u56fd\u5185\u65b0\u95fb\uff08\u6bcf\u676110\u5b57\u4ee5\u4e0a\uff09\n2. \u662f\u5426\u6709\u81f3\u5c1110\u6761\u56fd\u9645\u65b0\u95fb\uff08\u6bcf\u676110\u5b57\u4ee5\u4e0a\uff09\n3. \u662f\u5426\u5305\u542b\u6709\u6548\u7684 emoji \u6807\u7b7e\uff08\ud83c\udde8\ud83c\uddf3 / \ud83c\udf0d\uff09\n4. **\u6807\u9898\u4e2d\u7684\u65f6\u95f4\u8bcd\uff08\u5348\u95f4/\u665a\u95f4/\u591c\u95f4\uff09\u662f\u5426\u4e0e\u5f53\u524d\u8fd0\u884c\u65f6\u95f4\u5339\u914d**",
